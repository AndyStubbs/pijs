{
	"name": "pijs",
	"version": "2.3.0",
	"majorVersion": "2.3",
	"description": "Retro2D graphics, sound, and input library for javascript",
	"type": "module",
	"main": "build/pi.js",
	"directories": {
		"test": "test"
	},
	"scripts": {
		"benchmark": "node test/performance/benchmark/run.js",
		"test:benchmark": "node scripts/test.js benchmark",
		"build": "node scripts/build.js",
		"copy-to-release": "node scripts/copy-to-release.js",
		"metadata": "node scripts/generate-metadata.js",
		"test": "node scripts/test.js all",
		"test:grep": "node scripts/test.js visual --mode=full --grep",
		"test:lite": "node scripts/test.js visual --mode=lite",
		"test:lite:grep": "node scripts/test.js visual --mode=lite --grep",
		"test:plugins": "node scripts/test.js visual --mode=plugins",
		"test:plugins:grep": "node scripts/test.js visual --mode=plugins --grep",
		"test:metadata": "node scripts/test.js metadata",
		"test:performance-ui": "node scripts/test.js performance-ui",
		"test:types": "node scripts/test.js types",
		"server": "node server.js",
		"size": "node scripts/size.js",
		"sound:references": "node test/scripts/record-sound-references.js",
		"test:all": "node scripts/test.js all",
		"test:unit": "node scripts/test.js unit",
		"test:browser": "node scripts/test.js browser",
		"test:visual": "node scripts/test.js visual",
		"test:firefox": "node scripts/test.js firefox"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AndyStubbs/pijs"
	},
	"author": "Andy Stubbs",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/AndyStubbs/pijs/issues"
	},
	"homepage": "https://www.pijs.org",
	"engines": {
		"node": ">=18.0.0"
	},
	"devDependencies": {
		"@iarna/toml": "^2.2.3",
		"@playwright/test": "^1.56.0",
		"esbuild": "^0.25.10",
		"pngjs": "^7.0.0",
		"typescript": "^5.6.3"
	},
	"allowScripts": {
		"esbuild@0.25.10": true
	}
}
