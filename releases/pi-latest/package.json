{
	"name": "pijs-web",
	"version": "2.3.0",
	"majorVersion": "2.3",
	"description": "Retro2D graphics, sound, and input library for javascript",
	"types": "dist/pi.d.ts",
	"unpkg": "dist/pi.min.js",
	"jsdelivr": "dist/pi.min.js",
	"files": [
		"dist"
	],
	"exports": {
		".": {
			"types": "./dist/pi.d.ts",
			"import": "./dist/pi.esm.js",
			"default": "./dist/pi.esm.js"
		},
		"./lite": {
			"types": "./dist/pi.lite.d.ts",
			"import": "./dist/pi.lite.esm.js",
			"default": "./dist/pi.lite.esm.js"
		},
		"./plugins/gamepad": {
			"types": "./dist/plugins/gamepad/gamepad.d.ts",
			"import": "./dist/plugins/gamepad/gamepad.esm.js",
			"default": "./dist/plugins/gamepad/gamepad.esm.js"
		},
		"./plugins/keyboard": {
			"types": "./dist/plugins/keyboard/keyboard.d.ts",
			"import": "./dist/plugins/keyboard/keyboard.esm.js",
			"default": "./dist/plugins/keyboard/keyboard.esm.js"
		},
		"./plugins/pointer": {
			"types": "./dist/plugins/pointer/pointer.d.ts",
			"import": "./dist/plugins/pointer/pointer.esm.js",
			"default": "./dist/plugins/pointer/pointer.esm.js"
		},
		"./plugins/polygons": {
			"types": "./dist/plugins/polygons/polygons.d.ts",
			"import": "./dist/plugins/polygons/polygons.esm.js",
			"default": "./dist/plugins/polygons/polygons.esm.js"
		},
		"./plugins/sound": {
			"types": "./dist/plugins/sound/sound.d.ts",
			"import": "./dist/plugins/sound/sound.esm.js",
			"default": "./dist/plugins/sound/sound.esm.js"
		},
		"./plugins/sound-advanced": {
			"types": "./dist/plugins/sound-advanced/sound-advanced.d.ts",
			"import": "./dist/plugins/sound-advanced/sound-advanced.esm.js",
			"default": "./dist/plugins/sound-advanced/sound-advanced.esm.js"
		}
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/AndyStubbs/pijs"
	},
	"author": "Andy Stubbs <andy@pijs.org>",
	"license": "Apache-2.0",
	"bugs": {
		"url": "https://github.com/AndyStubbs/pijs/issues"
	},
	"homepage": "https://www.pijs.org",
	"keywords": [
		"2d",
		"graphics",
		"webgl",
		"canvas",
		"retro",
		"game-engine",
		"game-dev",
		"input",
		"sound",
		"javascript",
		"browser-game",
		"pixel-art"
	]
}
